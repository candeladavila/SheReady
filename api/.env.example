DATABASE_URL=postgresql+psycopg://sheready:sheready@localhost:5432/sheready
# Optional separate session connection for cloud migrations (Supabase port 5432).
MIGRATION_DATABASE_URL=
DATABASE_POOLING=queue
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
# Gemini and Ollama remain available by explicitly selecting AI_PROVIDER.
GEMINI_API_KEY=
# Model availability and free quota must be checked in your Google AI Studio project.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_VOICE=Kore
AI_TIMEOUT_SECONDS=60
MAX_AUDIO_BYTES=8388608
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
APP_TIMEZONE=Europe/Madrid
# Optional shared demo gate, not individual authentication. Keep blank for local development.
DEMO_ACCESS_TOKEN=
